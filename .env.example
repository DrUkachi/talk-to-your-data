# Copy to .env and fill in. Never commit .env or hardcode these values in code.

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist
POSTGRES_USER=olist_app
POSTGRES_PASSWORD=changeme
# Least-privilege role the MCP SQL tool connects as (Phase 2+; enforced as a guardrail in Phase 6)
POSTGRES_READONLY_USER=olist_readonly
POSTGRES_READONLY_PASSWORD=changeme

# --- Kaggle (one-off dataset fetch, Phase 1 scripts/fetch_data.py) ---
# New-style Kaggle access token (kagglehub), NOT the legacy username+key pair.
# Generate at https://www.kaggle.com/settings/api -- note it expires after 3 hours,
# so regenerate it right before running fetch_data.py if it's gone stale.
KAGGLE_API_TOKEN=

# --- MCP server (Phase 2) ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# --- LLM: Anthropic SDK via Microsoft Foundry ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Langfuse tracing (Phase 6) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Slack (Phase 6, Socket Mode) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
