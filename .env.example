# Copy to .env and fill in. Never commit .env or hardcode these values in code.

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist
POSTGRES_USER=olist_app
POSTGRES_PASSWORD=changeme
# Least-privilege role the MCP SQL tool connects as (Phase 2+; enforced as a guardrail in Phase 6)
POSTGRES_READONLY_USER=olist_readonly
POSTGRES_READONLY_PASSWORD=changeme

# --- Kaggle (one-off dataset fetch, Phase 1 scripts/fetch_data.py) ---
# Either of these works (kagglehub resolves whichever is set; KAGGLE_API_TOKEN
# takes priority if both are present):
# New-style Kaggle access token. Generate at https://www.kaggle.com/settings/api
# -- note it expires after 3 hours, so regenerate it right before running
# fetch_data.py locally if it's gone stale.
KAGGLE_API_TOKEN=
# Legacy username+key pair, long-lived -- what CI uses (a 3-hour token can't be
# a stored secret). Generate at the same URL above ("Create New API Token"
# downloads a kaggle.json with both values).
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- MCP server (Phase 2) ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# --- Cleaning agent API (Phase 3) ---
CLEANING_API_PORT=8001

# --- EDA supervisor agent API (Phase 4) ---
EDA_API_PORT=8002
# Must be an address a client can actually reach this service at -- the A2A
# agent card publishes this verbatim, it isn't resolved relative to anything.
EDA_API_BASE_URL=http://127.0.0.1:8002

# --- LLM: GPT-6.1-Sol via Microsoft Foundry (OpenAI-compatible endpoint) ---
# Shared with Codex CLI (~/.codex/config.toml reads OPENAI_API_KEY too) -- see docs/codex.md.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://<your-resource>.services.ai.azure.com/openai/v1
OPENAI_MODEL=gpt-6.1-sol

# --- Langfuse tracing (Phase 6) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Slack (Phase 6, Socket Mode) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
